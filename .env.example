# Application
APP_NAME="Gold Queen API"
ENVIRONMENT=development
# Exact origins only. Add a custom domain here; do not widen this into a wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://gold-queen-web.vercel.app,https://gold-queen-web-luizssantiago92.vercel.app
# Team that owns gold-queen-web. Preview CORS is derived from this when
# CORS_ORIGIN_REGEX is unset. A gold-queen-web-* pattern without the slug lets
# any Vercel account register a lookalike project and call the API.
VERCEL_TEAM_SLUG=luizssantiago92
# Optional override. Leave unset to derive the team-scoped preview pattern.
# Set to empty to accept only CORS_ORIGINS.
# CORS_ORIGIN_REGEX=^https://gold-queen-web-[a-z0-9-]+-luizssantiago92\.vercel\.app$

# Database
# Local Docker Postgres (see docker-compose.yml). Leave empty to fall back to SQLite.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gold_queen

# Auth
# Development accepts this placeholder. ENVIRONMENT=production refuses to start
# unless JWT_SECRET is different and at least 32 characters.
JWT_SECRET=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# In-process login throttle. Not shared across serverless isolates; see README.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_TRUST_PROXY_HEADERS=true

# Pluggy Open Finance (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Public signup. Leave unset to follow the environment: open in development
# and test, closed when ENVIRONMENT=production. Set true or false to override.
# ALLOW_REGISTRATION=true

# Business rules
MAX_BANK_CONNECTIONS=3
# Gemini's free tier allows 20 generations per day across the whole project,
# shared with Queen's Tips and categorization. Raise this only with paid billing.
CHAT_DAILY_LIMIT=5
